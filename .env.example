# Set the real value only in Vercel or your local ignored .env file.
ANTHROPIC_API_KEY=
# Optional override; defaults to the model already used by Proteva.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Supabase public project settings default to assets/config.js.
# Never put a service-role key in browser code.
# Enable only after migration and live policy verification in a private test.
DEVICE_INGEST_ENABLED=false
SUPABASE_SECRET_KEY=
